{
    "name": "ksfraser/ksf-fa-notes",
    "description": "FA module for Notes/Comments management with multi-entity linking, ACL, and OCR",
    "type": "fa-module",
    "license": "GPL-3.0",
    "require": {
        "php": ">=7.4",
        "ksfraser/traits": "*",
        "ksfraser/html": "dev-fix/constructor-compatibility",
        "ksfraser/ksf-fa-common": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\Notes\\": "src/Ksfraser/FA/Notes/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 0,
        "platform": {
            "php": "7.4.33"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Traits"
        }
    ]
}
